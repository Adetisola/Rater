# =========================================================================
# RATER PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to '.env.local' and fill in the corresponding values.
# =========================================================================

# -------------------------------------------------------------------------
# 1. Supabase Client Configurations (Publicly Accessible)
# -------------------------------------------------------------------------
# Your Supabase Project API Endpoint (e.g., https://yourproject.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url

# Your Supabase Anon Key (safe to expose in client/browser code)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# -------------------------------------------------------------------------
# 2. Cloudinary Media Asset CDN Configurations (Publicly Accessible)
# -------------------------------------------------------------------------
# Your Cloudinary Cloud Name
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# Unsigned upload preset configured in Cloudinary Dashboard for client-side uploads
NEXT_PUBLIC_CLOUDINARY_UNSIGNED_UPLOAD_PRESET=your_cloudinary_unsigned_preset

# -------------------------------------------------------------------------
# 3. Server-Side Keys (SECURE KEYS - KEEP PRIVATE - NEVER EXPOSE TO CLIENT)
# -------------------------------------------------------------------------
# Optional: Supabase service role key (For administrative triggers / administrative backend runs only)
# WARNING: Do NOT prefix this key with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Cloudinary private credentials (only if using server-side signed uploads)
# WARNING: Do NOT prefix these keys with NEXT_PUBLIC_.
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
